# -----------------------------------------------------------------------------
# Copy to .env.local for local development (never commit real values).
# On Railway, set these in the service's Variables tab (see README → Deploy).
# -----------------------------------------------------------------------------

# Public (inlined in the browser bundle — must not contain secrets).
# Canonical site URL, without trailing slash (SEO, sitemap, cookies, CSRF checks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (PostgreSQL 16+) -------------------------------------------------
# The website's own least-privilege role. `npm run db:migrate` creates it with
# this password (24+ characters: openssl rand -hex 24).
DATABASE_URL=postgresql://portfolio_app:CHANGE-ME-24-plus-characters@localhost:5432/portfolio
# Owner connection, used ONLY by `npm run db:migrate` and `npm run admin`.
# On Railway: ${{Postgres.DATABASE_URL}}
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio
# Optional (default 10).
DATABASE_POOL_MAX=

# --- Authentication (Better Auth) ---------------------------------------------
# 32+ random characters: openssl rand -base64 32. Changing it signs everyone
# out and invalidates 2FA secrets (run `npm run admin -- reset-2fa` afterwards).
BETTER_AUTH_SECRET=

# --- File storage (Cloudflare R2, private bucket) -------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only for local development/tests with an S3-compatible server. Leave empty in production.
R2_ENDPOINT=

# --- Optional -----------------------------------------------------------------
# Upload limits in MB.
PDF_MAX_SIZE_MB=30
IMAGE_MAX_SIZE_MB=4
# Days a contact-form message is kept before automatic deletion (LGPD; 30–3650).
CONTACT_RETENTION_DAYS=365
# Header with the real client IP. Default (Railway): x-forwarded-for.
# Behind Cloudflare's proxy (orange cloud): cf-connecting-ip.
TRUSTED_IP_HEADER=
