# -----------------------------------------------------------------------------
# Copy to .env.local (never commit real values).
# -----------------------------------------------------------------------------

# Public (inlined in the browser bundle — must not contain secrets)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Legacy "anon" JWT or new "sb_publishable_..." key. Safe to expose: RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL, without trailing slash (used for SEO, sitemap and CSRF origin checks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — NEVER prefix with NEXT_PUBLIC_ (the build fails if you do).
# Legacy "service_role" JWT or new "sb_secret_..." key.
SUPABASE_SERVICE_ROLE_KEY=

# Uploads (optional). Keep in sync with the bucket file_size_limit (supabase/migrations/*_storage.sql).
PDF_MAX_SIZE_MB=30
IMAGE_MAX_SIZE_MB=4

# Rate limiting (optional but recommended in production).
# Without these, an in-memory limiter is used (per server instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: enable "email me a sign-in link" on /admin/login (requires the
# email template change described in the README).
AUTH_MAGIC_LINK_ENABLED=false
